APP_ENV=development
PORT=8080
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

MONGODB_URI="mongodb://localhost:27017/?replicaSet=rs0&directConnection=true"
MONGODB_DATABASE=rinotravel_dev

REGISTRATION_CODE=dev-registration-code
TRUST_PROXY=false
AUTH_RATE_LIMIT=10

# Documents: files live in MongoDB (GridFS) and the API signs its own upload/download links.
# Leave STORAGE_SIGNING_SECRET empty to disable the feature. Use a random value of at least 32 characters.
# API_PUBLIC_URL is where clients reach this API (required outside development).
STORAGE_SIGNING_SECRET=
API_PUBLIC_URL=

# Google Maps Platform key for place search and route planning. Leave empty to disable.
GOOGLE_MAPS_API_KEY=
# Monthly ceiling of Google calls per API (place search and route planning), counted in MongoDB.
# Keep it below the free allowance (5,000 calls). 0 turns the ceiling off and usage past the allowance is billed.
GOOGLE_MONTHLY_LIMIT=4000
